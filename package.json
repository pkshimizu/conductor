{
  "name": "conductor-agent",
  "version": "0.1.0",
  "description": "GitHub Issue を受け取り、Claude Code の役を順に動かしてマージまで進める開発エージェント",
  "private": true,
  "type": "module",
  "bin": {
    "conductor": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
